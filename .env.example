# Production defaults to Arc Testnet onchain mode.
NEXT_PUBLIC_ARC_MODE=onchain

# Use mock for local no-wallet demos.
# NEXT_PUBLIC_ARC_MODE=mock

# Arc Testnet contract addresses. These public defaults are also embedded in lib/arc-config.ts.
NEXT_PUBLIC_ERC8004_REGISTRY_ADDRESS=0xd8499627775ac67cd756335a3c48387d0aff5553
NEXT_PUBLIC_ERC8183_ESCROW_ADDRESS=0x08eb8630f6b5d2c1c030688076b80360531a2e9a
NEXT_PUBLIC_ERC8183_ESCROW_V2_ADDRESS=0x6255f3fbb7b4f82062b929029dc005baf0ca3ebb
NEXT_PUBLIC_ESCROW_V2_INITIAL_JOB_ID=1000000
NEXT_PUBLIC_ERC8183_ESCROW_V3_ADDRESS=0x548531bbe48db4cded53da0d30998e7553eee53f
NEXT_PUBLIC_ESCROW_V3_INITIAL_JOB_ID=2000000
NEXT_PUBLIC_USDC_ADDRESS=native
NEXT_PUBLIC_ARCTASK_MANAGED_AGENT_ID=1

# Local-only deploy key. Never commit .env.local and never paste this key into chat.
ARC_TESTNET_DEPLOYER_PRIVATE_KEY=

# Local-only autonomous worker key. Use a dedicated funded agent-owner wallet.
# Worker defaults to dry-run unless ARC_AGENT_DRY_RUN=false is set.
ARC_AGENT_PRIVATE_KEY=
ARC_AGENT_DRY_RUN=true
# Never enable deployer fallback outside one-off local testing.
ARC_AGENT_ALLOW_DEPLOYER_FALLBACK=false
# ARC_AGENT_ONCE=true
ARC_AGENT_POLL_INTERVAL_MS=15000
ARC_AGENT_MAX_JOBS_PER_TICK=5
ARC_AGENT_MAX_JOB_PAYLOAD_CHARS=8000
# Use an indexed RPC for consistent reads while signed writes continue through NEXT_PUBLIC_ARC_RPC_URL.
ARC_AGENT_READ_RPC_URL=https://testnet.arcscan.app/api/eth-rpc

# Optional Vercel -> VPS fallback for worker deliverables and status.
ARCTASK_DELIVERABLE_REMOTE_BASE_URL=
# Shared server-to-server token for the fallback above.
ARCTASK_DELIVERABLE_REMOTE_TOKEN=
# Stable HMAC secret for one-time deliverable access challenges. Set the same value on every web runtime.
ARCTASK_ACCESS_NONCE_SECRET=
# Optional token for full /api/worker/status details. Public responses are sanitized.
ARCTASK_ADMIN_TOKEN=

# Optional AI executor for autonomous deliverables. Do not commit real keys.
OPENAI_API_KEY=
# Optional comma-separated backup keys. The worker rotates only when a provider key is quota-blocked.
OPENAI_FALLBACK_API_KEYS=
OPENAI_MODEL=gpt-5.6-sol
ARC_AGENT_PROVIDER_QUOTA_COOLDOWN_MS=300000
ARC_AGENT_PROVIDER_QUOTA_MAX_COOLDOWN_MS=3600000
ARC_AGENT_MAX_JOB_TOTAL_TOKENS=30000
ARC_AGENT_MAX_REQUESTS_PER_JOB=2
ARC_AGENT_ROUTER_MODEL=gpt-5.4-nano
ARC_AGENT_ROUTER_MAX_COST_USD=0.003
ARC_AGENT_EMERGENCY_MONTHLY_SPEND_LIMIT_USD=100
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_MS=180000
OPENAI_HTTP_TIMEOUT_MS=30000
OPENAI_POLL_INTERVAL_MS=3000
OPENAI_MAX_OUTPUT_TOKENS=3000
# Dynamic routing is enforced by default. Use shadow to observe recommendations
# while keeping OPENAI_MODEL, or off to disable reward/complexity routing.
ARC_AGENT_ROUTING_MODE=enforce
# Testnet-only escape hatch for seeded/demo jobs. Keep false for paid production work.
ARC_AGENT_DEMO_SUBSIDY=false
# Exact IDs may be temporarily recovered at the complexity-required tier without disabling enforcement globally.
ARC_AGENT_RECOVERY_JOB_IDS=
ARC_AGENT_MAX_RUNTIME_MS=900000
ARC_AGENT_MAX_OUTPUT_TOKENS=24000
# Keep false in production. Failed AI work must remain FUNDED instead of submitting a placeholder.
ARC_AGENT_ALLOW_DETERMINISTIC_FALLBACK=false
# Set true when autonomous jobs should discover current public market data, such as upcoming TGE tokens.
ARC_AGENT_ENABLE_WEB_SEARCH=false
ARC_AGENT_WEB_SEARCH_CONTEXT=medium
